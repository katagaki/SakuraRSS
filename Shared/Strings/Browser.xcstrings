    "Topics.Disabled.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktiviere Inhalts-Insights in den Einstellungen, damit Sakura Themen und Personen aus deinen Inhalten erkennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Content Insights in Settings to have Sakura pick out topics and people from your content."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez les analyses de contenu dans les réglages pour que Sakura repère les sujets et les personnes dans vos contenus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Approfondimenti sui contenuti nelle impostazioni per far individuare a Sakura argomenti e persone nei tuoi contenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定でコンテンツインサイトをオンにすると、Sakura がコンテンツからトピックと人物を抽出します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 콘텐츠 인사이트를 켜면 Sakura가 콘텐츠에서 주제와 인물을 찾아냅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet Contentinzichten aan in de instellingen zodat Sakura onderwerpen en personen uit je inhoud haalt."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bật Thông tin nội dung trong cài đặt để Sakura nhận diện chủ đề và nhân vật trong nội dung của bạn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在设置中开启内容洞察，Sakura 便会从内容中提取话题与人物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在設定中開啟內容洞察，Sakura 便會從內容中擷取話題與人物。"
          }
        }
      }
    },
